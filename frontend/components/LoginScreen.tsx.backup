"use client";

import { useState } from "react";
import { api, setToken, ApiError } from "@/lib/api";
import type { AuthResponse } from "@/lib/types";

const DEMO_ACCOUNTS: { username: string; password: string; role: string }[] = [
  { username: "investigator", password: "investigator123", role: "full access" },
  { username: "reviewer", password: "reviewer123", role: "label + report" },
  { username: "viewer", password: "viewer123", role: "read-only" },
];

export default function LoginScreen({ onLoggedIn }: { onLoggedIn: (auth: AuthResponse) => void }) {
  const [username, setUsername] = useState("investigator");
  const [password, setPassword] = useState("investigator123");
  const [error, setError] = useState<string | null>(null);
  const [busy, setBusy] = useState(false);

  async function submit(e: React.FormEvent) {
    e.preventDefault();
    setBusy(true);
    setError(null);
    try {
      const auth = await api.login(username, password);
      setToken(auth.access_token);
      onLoggedIn(auth);
    } catch (err) {
      setError(err instanceof ApiError ? err.message : "Could not reach the backend API");
    } finally {
      setBusy(false);
    }
  }

  return (
    <div className="relative flex h-screen w-screen items-center justify-center overflow-hidden bg-[#0b0d12]">
      {/* animated background orbs */}
      <div className="pointer-events-none absolute inset-0">
        <div className="absolute -top-32 -left-32 h-96 w-96 rounded-full bg-cyan-500/10 blur-[100px] animate-pulse-glow" />
        <div className="absolute -right-32 top-1/3 h-96 w-96 rounded-full bg-indigo-500/10 blur-[100px] animate-float" />
        <div className="absolute bottom-0 left-1/3 h-96 w-96 rounded-full bg-teal-500/10 blur-[100px]" />
      </div>

      <form
        onSubmit={submit}
        className="glass-card relative z-10 w-[380px] p-8 animate-float"
        style={{ animationDuration: "8s" }}
      >
        <div className="mb-6 flex items-center gap-3">
          <div className="flex h-11 w-11 items-center justify-center rounded-xl bg-cyan-500/20 text-cyan-300 shadow-[0_0_30px_rgba(34,211,238,0.3)]">
            ◆
          </div>
          <div>
            <div className="text-xl font-semibold text-white">ForensAI</div>
            <div className="text-xs text-gray-500">AI-assisted forensic triage</div>
          </div>
        </div>

        <label className="mb-1 block text-xs text-gray-400">Username</label>
        <input
          className="input-glass mb-3 w-full px-3 py-2.5 text-sm text-white placeholder:text-gray-600"
          value={username}
          onChange={(e) => setUsername(e.target.value)}
        />

        <label className="mb-1 block text-xs text-gray-400">Password</label>
        <input
          type="password"
          className="input-glass mb-4 w-full px-3 py-2.5 text-sm text-white placeholder:text-gray-600"
          value={password}
          onChange={(e) => setPassword(e.target.value)}
        />

        {error && (
          <div className="mb-3 rounded-lg border border-bad/40 bg-bad/10 px-3 py-2 text-xs text-bad">{error}</div>
        )}

        <button
          type="submit"
          disabled={busy}
          className="liquid-btn w-full py-2.5 text-sm font-semibold disabled:opacity-50"
        >
          {busy ? "Signing in..." : "Sign in"}
        </button>

        <div className="mt-5 border-t border-border/60 pt-4 text-xs text-gray-500">
          <div className="mb-2 text-gray-400">Demo accounts (insecure, demo only):</div>
          <div className="space-y-1">
            {DEMO_ACCOUNTS.map((a) => (
              <button
                type="button"
                key={a.username}
                onClick={() => {
                  setUsername(a.username);
                  setPassword(a.password);
                }}
                className="flex w-full items-center justify-between rounded-lg border border-transparent px-3 py-1.5 text-left transition hover:border-cyan-400/20 hover:bg-cyan-400/5"
              >
                <span className="text-gray-300">{a.username}</span>
                <span className="text-gray-600">{a.role}</span>
              </button>
            ))}
          </div>
        </div>
      </form>
    </div>
  );
}