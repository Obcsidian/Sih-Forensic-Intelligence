# Copy to .env and adjust as needed. All values below are safe demo defaults.

# SQLite by default (zero setup). For production, point at Postgres instead, e.g.:
# DATABASE_URL=postgresql+psycopg2://forensai:forensai@localhost:5432/forensai
DATABASE_URL=sqlite:///./forensai.db

# JWT signing secret — MUST be replaced before any non-demo deployment.
SECRET_KEY=demo-insecure-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Celery broker/backend. If Redis isn't reachable, tasks run eagerly (inline)
# instead of failing, so the demo works without a Redis server.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Directory where uploaded/ingested case folders are stored.
STORAGE_DIR=./storage

# faster-whisper model size: tiny/base/small/medium/large-v3
WHISPER_MODEL=small

CORS_ORIGINS=http://localhost:3000
