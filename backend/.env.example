# --- AI Gateway (free multi-model provider; the AI is centralised here) ---
# Sign up for a free key at https://omniroute.dev and paste it here.
# Leave blank to run fully offline using local models (torch/faster-whisper/
# sentence-transformers/facenet-pytorch). With a key set, local models become
# optional fallbacks if the gateway is unavailable.
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://api.omniroute.dev/v1
AI_GATEWAY_ENABLED=1
AI_FALLBACK_LOCAL=1
AI_DAILY_LIMIT=5000

# Model selection ("auto" lets the gateway pick the best available model)
AI_CHAT_MODEL=auto
AI_VISION_MODEL=auto
AI_EMBEDDING_MODEL=auto
AI_AUDIO_MODEL=auto
